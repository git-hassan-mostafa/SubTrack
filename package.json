{
  "name": "subtrack",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS Generator Management System — Multi-tenant, offline-first",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@subtrack/api",
    "dev:mobile": "turbo run dev --filter=@subtrack/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
