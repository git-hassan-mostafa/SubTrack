# ─────────────────────────────────────────────────────────────────
# SubTrack — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL (Neon Postgres or any Postgres instance)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/subtrack?schema=public"

# JWT
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Twilio WhatsApp (optional — messaging is fire-and-forget)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# API Server
PORT=3000
